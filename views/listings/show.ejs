<% layout("layouts/boilerplate") %>

<div class="row mt-3">

  <!-- TITLE -->
  <div class="col-12 text-center">
    <h3 class="listing-title"><%= listing.title %></h3>
    <p class="text-muted">
      <%= listing.location %>, <%= listing.country %>
    </p>
  </div>

  <!-- IMAGE -->
  <div class="col-lg-8 col-md-10 col-12 mx-auto mb-3">
    <img src="<%= listing.image.url %>" class="show-img img-fluid" alt="listing_image" />
  </div>

  <!-- DETAILS -->
  <div class="col-lg-8 col-md-10 col-12 mx-auto">

    <p>Hosted by <b><%= listing.owner.username %></b></p>

    <p><%= listing.description %></p>

    <h5>
      ₹ <%= listing.price ? listing.price.toLocaleString("en-IN") : "N/A" %> / night
    </h5>

  </div>

  <!-- BUTTONS -->
  <% if(currUser && currUser._id.equals(listing.owner._id)) { %>
    <div class="col-12 text-center mt-3">
      <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-dark me-2">Edit</a>

      <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline">
        <button class="btn btn-dark">Delete</button>
      </form>
    </div>
  <% } %>

  <!-- REVIEW SECTION -->
  <div class="col-lg-8 col-md-10 col-12 mx-auto mt-4">

    <hr>

    <% if(currUser) { %>
      <h4>Leave a Review</h4>

      <form action="/listings/<%= listing.id %>/reviews" method="POST" novalidate class="needs-validation">

        <div class="mb-3">
          <label class="form-label">Rating:</label>
 <fieldset class="starability-slot">
  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />

  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
  <label for="first-rate1" title="Terrible">1 star</label>

  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
  <label for="first-rate2" title="Not good">2 stars</label>

  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
  <label for="first-rate3" title="Average">3 stars</label>

  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
  <label for="first-rate4" title="Very good">4 stars</label>

  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
  <label for="first-rate5" title="Amazing">5 stars</label>
</fieldset>

        <div class="mb-3">
          <textarea name="review[comment]" class="form-control" placeholder="Write your review..." required></textarea>
        </div>

        <button class="btn btn-dark">Submit</button>
      </form>

      <hr>
    <% } %>

    <!-- REVIEWS -->
    <h5>All Reviews</h5>

    <div class="row">
      <% for(review of listing.reviews) { %>

        <div class="col-md-6 col-12 mb-3">
          <div class="review-card">

            <div class="d-flex justify-content-between align-items-center mb-2">
              <b>@<%= review.author.username %></b>
              <span class="starability-result" data-rating="<%= review.rating %>"></span>
            </div>

            <p><%= review.comment %></p>

            <% if(currUser && review.author._id.equals(currUser._id)) { %>
              <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                <button class="btn btn-sm btn-outline-dark">Delete</button>
              </form>
            <% } %>

          </div>
        </div>

      <% } %>
    </div>

  </div>

</div>