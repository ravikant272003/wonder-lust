<% layout("layouts/boilerplate")%>

<div class="row justify-content-center mt-4">

  <div class="col-lg-6 col-md-8 col-11">

    <div class="card edit-card p-4">

      <h3 class="text-center mb-4">Edit your listing</h3>

      <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" 
        novalidate class="needs-validation" enctype="multipart/form-data">

        <!-- TITLE -->
        <div class="mb-3">
          <label class="form-label">Title</label>    
          <input class="form-control" type="text" value="<%= listing.title %>" name="listing[title]" required>
          <div class="valid-feedback">Looks good!</div>
        </div>    

        <!-- DESCRIPTION -->
        <div class="mb-3">
          <label class="form-label">Description</label>      
          <textarea class="form-control" name="listing[description]" required><%= listing.description %></textarea>
          <div class="invalid-feedback">Please enter a description</div>
        </div>

        <!-- CURRENT IMAGE -->
        <div class="mb-3 text-center">
          <p class="text-muted mb-2">Current Image</p>
          <img src="<%= orignalImageUrl %>" class="edit-img" />
        </div>

        <!-- NEW IMAGE -->
        <div class="mb-3">
          <label class="form-label">Upload New Image</label>      
          <input class="form-control" type="file" name="listing[image]">
        </div>

        <!-- PRICE + COUNTRY -->
        <div class="row">
          <div class="mb-3 col-md-4">
            <label class="form-label">Price</label>      
            <input class="form-control" type="number" value="<%= listing.price %>" name="listing[price]" required>
          </div>

          <div class="mb-3 col-md-8">
            <label class="form-label">Country</label>          
            <input class="form-control" type="text" value="<%= listing.country %>" name="listing[country]" required>
          </div>
        </div>

        <!-- LOCATION -->
        <div class="mb-3">
          <label class="form-label">Location</label>          
          <input class="form-control" type="text" value="<%= listing.location %>" name="listing[location]" required>
        </div>

        <!-- BUTTON -->
        <button class="btn btn-dark w-100 mt-2">Save Changes</button>

      </form>

    </div>

  </div>

</div>